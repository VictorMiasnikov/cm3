readonly TARGET = "AMD64_LINUX" % code generation target
readonly GNU_PLATFORM = "amd64-linux" % "cpu-os" string for GNU

SYSTEM_CC = "gcc -m64 -fPIC -g" % C compiler
SYSTEM_CXXC = "g++ -m64 -fPIC -g" % C++ compiler

% Sometimes stabs are incorrect for C.
% But Dwarf interferes with m3gdb.
% https://gcc.gnu.org/bugzilla/show_bug.cgi?id=99457
%
% VVM temp-ry turn off if defined("M3_BACKEND_MODE")
% VVM temp-ry turn off   if not equal(M3_BACKEND_MODE, "C")
% VVM temp-ry turn off     SYSTEM_CC = SYSTEM_CC & "stabs+"
% VVM temp-ry turn off     SYSTEM_CXXC = SYSTEM_CXXC & "stabs+"
% VVM temp-ry turn off   end
% VVM temp-ry turn off else
% VVM temp-ry turn off   % It will likely not default to C.
% VVM temp-ry turn off   SYSTEM_CC = SYSTEM_CC & "stabs+"
% VVM temp-ry turn off   SYSTEM_CXXC = SYSTEM_CXXC & "stabs+"
% VVM temp-ry turn off end

readonly SYSTEM_ASM = "as --64" % Assembler

% C++ zero-cost exception handling (ex_stack) with the C backend, which
% concierge.py uses by default; the gcc, llvm and integrated backends use
% ex_frame.  cm3.cfg sets M3_BACKEND_MODE before including this file.
% Requires libunwind-dev: apt-get install libunwind-dev
if defined("M3_BACKEND_MODE")
  if equal(M3_BACKEND_MODE, "C")
    M3_USE_STACK_WALKER = TRUE
  end
end

% ex_stack requires the C backend and g++ with -x c++.
% M3_BACKEND_MODE must be set before includes so cm3cfg.common's
% "if not defined" guard fires correctly.
if defined("M3_USE_STACK_WALKER")
  M3_BACKEND_MODE = "C"
  % Link through g++ so libstdc++ (__cxa_throw, __gxx_personality_v0, ...)
  % is pulled in.  Linux.common builds SYSTEM_LD from SYSTEM_CXXXC, which
  % otherwise defaults to SYSTEM_CC (gcc) as it stands at include time.
  % Not "-x c++": that would make the linker driver treat .o files as source.
  SYSTEM_CXXXC = "g++ -g -m64 -fPIC"
end

include("AMD64.common")
include("Linux.common")

SYSTEM_LIBS{"LIBC"} += [ "-lquadmath" ]

if defined("M3_USE_STACK_WALKER")
  % RTStackC.c and M3C.m3-generated files use C++ EH (catch/_M3Exc/throw),
  % so SYSTEM_CC must invoke the C++ compiler with -x c++.
  % -Wno-return-type as on Darwin: a function that ends in a TRY whose
  % handlers all RETURN is complete, but g++ cannot see that through the
  % C++ try/catch M3C emits.
  SYSTEM_CC = "g++ -g -m64 -fPIC -x c++ -Wno-return-type"
  SYSTEM_LIBS{"UNWIND"} = [ "-lunwind-x86_64", "-lunwind" ]
end

% PIE debugging requires gdb 7.1 or newer, even for C
% see http://www.gnu.org/software/gdb/download/ANNOUNCEMENT
%uncomment this define to use m3gdb
readonly POSITION_INDEPENDENT_EXECUTABLE = "-no-pie"

% M3C declares EXTENDED as _Float128, which g++ < 13 (Debian 12) lacks in C++;
% __float128 is the same IEEE binary128 type on x86-64.
if not equal(try_exec("@echo '_Float128 x;' | g++ -x c++ -fsyntax-only - >/dev/null 2>&1"), 0)
  SYSTEM_CC = SYSTEM_CC & " -D_Float128=__float128"
  SYSTEM_CXXC = SYSTEM_CXXC & " -D_Float128=__float128"
end
